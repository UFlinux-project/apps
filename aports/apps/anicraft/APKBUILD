	wayland-libs-egl
	hicolor-icon-theme
	shared-mime-info
	alsa-lib
	"
subpackages="
	$pkgname-doc
	"
source="anicraft-0.3.0.tar.gz::https://github.com/storytold/anicraft/archive/refs/tags/v0.3.0.tar.gz"
